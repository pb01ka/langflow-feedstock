+# passlib (unmaintained since 2020) was written against bcrypt's pre-4.1 behavior
+# of silently truncating secrets over 72 bytes. Modern bcrypt (>=4.1) raises
+# ValueError instead, which breaks passlib's CryptContext the first time it hashes
+# or verifies anything -- including detect_wrap_bug()'s own internal self-test, so
+# this fires on startup before any real password is touched. bcrypt's cipher only
+# ever consumes the first 72 bytes of a secret regardless, so pre-truncating here
+# reproduces exactly the hash bcrypt would have produced anyway; it does not change
+# what gets hashed for any password bcrypt actually uses.
+def _bcrypt_truncate_72(secret: bytes) -> bytes:
+    return secret[:72] if len(secret) > 72 else secret
 
 
+if not hasattr(bcrypt, "__about__"):
+    import types
+
+    bcrypt.__about__ = types.SimpleNamespace(__version__=bcrypt.__version__)
+
+_bcrypt_hashpw = bcrypt.hashpw
+_bcrypt_checkpw = bcrypt.checkpw
+bcrypt.hashpw = lambda password, salt: _bcrypt_hashpw(_bcrypt_truncate_72(password), salt)
+bcrypt.checkpw = lambda password, hashed: _bcrypt_checkpw(_bcrypt_truncate_72(password), hashed)
